{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "vitest"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@astur-mobile/android": ["../packages/android/src/index.ts"],
      "@astur-mobile/cli": ["../packages/cli/src/index.ts"],
      "@astur-mobile/core": ["../packages/core/src/index.ts"],
      "@astur-mobile/ios": ["../packages/ios/src/index.ts"],
      "@astur-mobile/protocol": ["../packages/protocol/src/index.ts"],
      "@astur-mobile/test": ["../packages/test/src/index.ts"]
    }
  },
  "include": ["*.test.ts"]
}
