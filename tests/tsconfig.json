{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "vitest"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@astur/android": ["../packages/android/src/index.ts"],
      "@astur/cli": ["../packages/cli/src/index.ts"],
      "@astur/core": ["../packages/core/src/index.ts"],
      "@astur/ios": ["../packages/ios/src/index.ts"],
      "@astur/protocol": ["../packages/protocol/src/index.ts"],
      "@astur/test": ["../packages/test/src/index.ts"]
    }
  },
  "include": ["*.test.ts"]
}
