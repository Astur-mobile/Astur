{
  "name": "astur-monorepo",
  "version": "0.5.0-beta.5",
  "private": true,
  "description": "Astur monorepo for device-native mobile automation.",
  "license": "Apache-2.0",
  "author": "Amr Salem",
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "docs:dev": "npm run dev -w docs-site",
    "docs:build": "npm run build -w docs-site",
    "docs:preview": "npm run preview -w docs-site",
    "docs:sync": "npm run sync -w docs-site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "npm run build && vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "astur-mobile": "0.5.0-beta.5",
    "create-astur": "0.5.0-beta.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "^8.0.13"
  }
}
