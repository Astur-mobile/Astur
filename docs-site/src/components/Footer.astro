---
// Extends Starlight's default footer with an elegant "Support Astur" Ko-fi link.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<div class="astur-support-footer">
  <a
    class="astur-kofi"
    href="https://ko-fi.com/asturmobile"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Support Astur on Ko-fi"
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
      <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
      <line x1="6" y1="1" x2="6" y2="4"></line>
      <line x1="10" y1="1" x2="10" y2="4"></line>
      <line x1="14" y1="1" x2="14" y2="4"></line>
    </svg>
    <span>Support Astur</span>
  </a>
</div>
