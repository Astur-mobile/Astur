:root {
  --sl-font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --sl-color-accent-low: #dff8f5;
  --sl-color-accent: #0f8f86;
  --sl-color-accent-high: #063d48;
  --sl-color-white: #ffffff;
  --sl-content-width: 50rem;
  --sl-text-5xl: 4.5rem;
}

:root[data-theme="light"] {
  --sl-color-bg: #ffffff;
  --sl-color-bg-nav: rgba(255, 255, 255, 0.86);
  --sl-color-bg-sidebar: #f7fafc;
  --sl-color-bg-inline-code: #edf6f6;
  --sl-color-hairline: #d9e6ee;
  --sl-color-hairline-light: #edf3f6;
  --sl-color-text: #10243f;
  --sl-color-text-accent: #0f8f86;
  --sl-color-text-invert: #ffffff;
}

:root[data-theme="dark"] {
  --sl-color-bg: #07111f;
  --sl-color-bg-nav: rgba(7, 17, 31, 0.86);
  --sl-color-bg-sidebar: #0a1424;
  --sl-color-accent-low: #073f46;
  --sl-color-accent: #24c6b7;
  --sl-color-accent-high: #dff8f5;
}

.site-title {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-weight: 760;
  letter-spacing: 0;
}

.site-title::after {
  content: "Docs";
  font-size: 1.4rem;
  font-weight: 500;
  color: #52637a;
  margin-left: 0.25rem;
  display: inline-block;
  align-self: center;
  letter-spacing: -0.02em;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

:root[data-theme="dark"] .site-title::after {
  color: rgba(219, 233, 245, 0.55);
}

.site-title:hover::after {
  color: var(--cyber-primary, #14b8a6) !important;
  text-shadow: 0 0 12px rgba(20, 184, 166, 0.6);
}

.site-title img {
  height: 2.2rem;
  max-width: 8.8rem;
  object-fit: contain;
}

.header {
  backdrop-filter: blur(18px);
  border-bottom-color: var(--sl-color-hairline-light);
}

.sidebar-pane {
  border-right-color: var(--sl-color-hairline-light);
}

.sidebar a[aria-current="page"] {
  border-radius: 0.7rem;
  font-weight: 700;
}

:root[data-theme="light"] .sidebar a:hover:not([aria-current="page"]) {
  background: #e9f4f4;
  color: #10243f;
}

:root[data-theme="light"] .sidebar a[aria-current="page"] {
  color: #ffffff;
}

.hero {
  border-bottom: 1px solid var(--sl-color-hairline-light);
  margin-bottom: 2rem;
}

.hero img {
  border-radius: 1.5rem;
  box-shadow: 0 24px 70px rgba(10, 23, 48, 0.16);
}

.hero .tagline {
  color: #62748e;
}

:root[data-theme="light"] .hero h1 {
  color: #10243f;
}

:root[data-theme="light"] h1 {
  color: #10243f;
}

:root[data-theme="light"] .sl-markdown-content :is(h1, h2, h3, h4, h5, h6),
:root[data-theme="light"] .sl-markdown-content :is(h1, h2, h3, h4, h5, h6) a {
  color: #10243f !important;
  background: transparent !important;
}

:root[data-theme="light"] .sl-markdown-content :is(h2, h3, h4):hover a {
  color: #0f8f86 !important;
}

:root[data-theme="light"] .sidebar-pane :is(h2, summary, [class*="group-label"]) {
  color: #10243f;
}

:root[data-theme="light"] .sidebar-pane .large {
  color: #10243f !important;
}

:root[data-theme="dark"] .hero .tagline {
  color: #b7c7d8;
}

.pagination-links a {
  border-radius: 1rem;
  transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
}

:root[data-theme="light"] .pagination-links a {
  color: #4f6279;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 250, 253, 0.98));
  border-color: #d9e6ee;
  box-shadow: 0 16px 34px rgba(16, 36, 63, 0.08);
}

:root[data-theme="light"] .pagination-links a .link-title,
:root[data-theme="light"] .pagination-links a:hover .link-title,
:root[data-theme="light"] .pagination-links a:focus-visible .link-title {
  color: #10243f !important;
}

:root[data-theme="light"] .pagination-links a:hover,
:root[data-theme="light"] .pagination-links a:focus-visible {
  color: #10243f;
  border-color: #b7cfdb;
  background: linear-gradient(180deg, #ffffff, #f2f8fb);
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 2.5rem;
  padding: clamp(2rem, 4vw, 3.5rem);
  min-height: clamp(22rem, 58vw, 30rem);
  border: 1px solid rgba(163, 184, 204, 0.18);
  border-radius: 1.7rem;
  background:
    radial-gradient(circle at 18% 22%, rgba(96, 210, 198, 0.18), transparent 26%),
    radial-gradient(circle at 82% 18%, rgba(126, 92, 255, 0.12), transparent 24%),
    linear-gradient(135deg, #07111f, #0a1323 50%, #0b1628 100%);
  border-bottom-color: rgba(163, 184, 204, 0.18);
  box-shadow: 0 28px 80px rgba(3, 10, 22, 0.28);
}

.hero::before,
.landing-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
  background-size: 3rem 3rem;
  mask-image: linear-gradient(135deg, rgba(255, 255, 255, 0.75), transparent 86%);
  opacity: 0.55;
}

.hero::after {
  content: "";
  position: absolute;
  inset: auto -12% -18% auto;
  width: clamp(18rem, 32vw, 30rem);
  aspect-ratio: 1;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(36, 198, 183, 0.18), transparent 62%);
  filter: blur(10px);
  pointer-events: none;
}

.hero > * {
  position: relative;
  z-index: 1;
}

.hero .stack {
  max-width: 42rem;
  gap: 1.5rem;
}

.hero .copy {
  gap: 1rem;
}

.hero h1 {
  max-width: 8ch;
  color: #f8fbff;
  font-size: clamp(3.6rem, 7vw, 5.8rem);
  line-height: 0.96;
  letter-spacing: -0.05em;
}

.hero .tagline {
  max-width: 38rem;
  color: rgba(219, 233, 245, 0.78);
  font-size: clamp(1.08rem, 1rem + 0.5vw, 1.4rem);
  line-height: 1.65;
}

.hero .actions {
  gap: 0.85rem;
  flex-wrap: wrap;
}

.hero .sl-link-button {
  border-radius: 999px;
  padding: 0.95rem 1.35rem;
  font-weight: 700;
  box-shadow: none;
}

.hero .sl-link-button.primary {
  border-color: transparent;
  background: linear-gradient(135deg, #dff8f5, #cbeff9);
  color: #07111f;
}

.hero .sl-link-button.secondary {
  border-color: rgba(219, 233, 245, 0.36);
  background: rgba(255, 255, 255, 0.03);
  color: #f8fbff;
}

.hero .sl-link-button.secondary:hover,
.hero .sl-link-button.secondary:focus-visible {
  border-color: rgba(219, 233, 245, 0.6);
  background: rgba(255, 255, 255, 0.06);
}

/* Futuristic Theme Variables */
:root {
  --cyber-primary: #14b8a6;
  --cyber-primary-glow: rgba(20, 184, 166, 0.12);
  --cyber-secondary: #6366f1;
  --cyber-secondary-glow: rgba(99, 102, 241, 0.08);
  --cyber-bg-glass: rgba(6, 11, 22, 0.65);
  --cyber-border-glass: rgba(255, 255, 255, 0.06);
  --neon-emerald: #10b981;
}

:root[data-theme="light"] {
  --cyber-bg-glass: rgba(248, 250, 252, 0.75);
  --cyber-border-glass: rgba(15, 23, 42, 0.06);
}

/* 1. Concentric Astrolabe Orbits & Animations */
@keyframes rotate-clockwise {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes rotate-counterclockwise {
  from { transform: translate(-50%, -50%) rotate(360deg); }
  to { transform: translate(-50%, -50%) rotate(0deg); }
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 0.8; }
}

.astrolabe-orbits {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
  opacity: 0.45;
}
.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  border: 1px dashed rgba(20, 184, 166, 0.12);
  transform: translate(-50%, -50%);
  box-shadow: inset 0 0 20px rgba(20, 184, 166, 0.02);
}
.orbit-outer {
  width: 620px;
  height: 620px;
  animation: rotate-clockwise 45s linear infinite;
}
.orbit-middle {
  width: 440px;
  height: 440px;
  border: 1px dashed rgba(99, 102, 241, 0.08);
  animation: rotate-counterclockwise 35s linear infinite;
}
.orbit-inner {
  width: 260px;
  height: 260px;
  border: 1px solid rgba(20, 184, 166, 0.06);
  animation: rotate-clockwise 25s linear infinite;
}
.orbit-marker {
  position: absolute;
  width: 6px;
  height: 6px;
  background-color: var(--cyber-primary);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--cyber-primary);
}
.orbit-outer .orbit-marker { 
  top: 14%; 
  left: 14%; 
  background-color: var(--cyber-secondary); 
  box-shadow: 0 0 10px var(--cyber-secondary); 
}
.orbit-middle .orbit-marker { 
  bottom: 22%; 
  right: 17%; 
}
.orbit-inner .orbit-marker { 
  top: 0; 
  left: 50%; 
  transform: translateX(-50%); 
}

/* 2. Premium Hero Area (Full-Bleed Viewport Section) */
.futuristic-hero {
  position: relative;
  overflow: hidden;
  margin-top: 0;
  margin-bottom: 4rem;
  padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.5rem, 4vw, 3.5rem);
  
  /* Break out of standard content container to full viewport width */
  width: 100vw;
  left: 50%;
  transform: translateX(-50%);
  
  border: none;
  border-bottom: 1px solid var(--cyber-border-glass);
  border-radius: 0;
  
  background: 
    radial-gradient(circle at 10% 20%, rgba(20, 184, 166, 0.12), transparent 35%),
    radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.08), transparent 35%),
    linear-gradient(135deg, #020617 0%, #0b1528 50%, #070c1b 100%);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  text-align: center;
}
.futuristic-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 2.5rem 2.5rem;
  mask-image: radial-gradient(circle at center, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.15) 75%, transparent 100%);
  opacity: 0.6;
  z-index: 0;
}
.futuristic-hero-content {
  position: relative;
  z-index: 1;
  max-width: 44rem;
  margin: 0 auto;
}
.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  justify-content: center;
  margin-bottom: 1.5rem;
}
.cyber-badge {
  font-family: monospace;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--cyber-primary);
  background: rgba(20, 184, 166, 0.08);
  border: 1px solid rgba(20, 184, 166, 0.18);
  border-radius: 999px;
  padding: 0.35rem 0.75rem;
  text-transform: uppercase;
}
.gradient-headline {
  margin: 0 0 1.5rem 0 !important;
  font-size: clamp(2.3rem, 5vw, 3.8rem) !important;
  font-weight: 800 !important;
  line-height: 1.1 !important;
  letter-spacing: -0.04em !important;
  background: linear-gradient(135deg, #ffffff 40%, #cbd5e1 70%, #14b8a6 100%);
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  color: transparent !important;
}
.futuristic-tagline,
.futuristic-tagline p {
  font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem) !important;
  line-height: 1.6 !important;
  color: #94a3b8 !important;
  margin: 0 auto 2.25rem !important;
  font-weight: 450 !important;
}
.hero-cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.85rem 1.75rem;
  border-radius: 999px;
  font-weight: 700;
  font-size: 1rem;
  line-height: 1; /* Resets default button line height */
  text-decoration: none !important;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}
.cta-button.primary {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  color: #ffffff !important;
  box-shadow: 0 4px 20px rgba(20, 184, 166, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.cta-button.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(20, 184, 166, 0.5);
}
.cta-button.secondary {
  background: rgba(255, 255, 255, 0.03);
  color: #ffffff !important;
  border: 1px solid var(--cyber-border-glass);
  backdrop-filter: blur(8px);
}
.cta-button.secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  transform: translateY(-2px);
}
.arrow-icon {
  display: inline-block;
  vertical-align: middle;
  margin-top: -1px; /* Center perfectly with button capital letters */
  transition: transform 0.3s ease;
}
.cta-button.primary:hover .arrow-icon {
  transform: translateX(4px);
}

/* Hide Starlight's default h1 title panel on splash pages (where no sidebar exists) to prevent double headers */
body:not(:has(#starlight__sidebar)) .content-panel:has(h1#_top) {
  display: none !important;
}

/* Light theme overrides for Hero */
:root[data-theme="light"] .futuristic-hero {
  border: none;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  border-radius: 0;
  background: 
    radial-gradient(circle at 10% 20%, rgba(20, 184, 166, 0.08), transparent 35%),
    radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.06), transparent 35%),
    linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
}
:root[data-theme="light"] .futuristic-hero::before {
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 23, 42, 0.02) 1px, transparent 1px);
}

/* Highly specific class chain to override Starlight's global light-mode heading overrides */
:root[data-theme="light"] .sl-markdown-content h1.gradient-headline {
  background: linear-gradient(135deg, #0f172a 40%, #1e293b 70%, #0d9488 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  color: transparent !important;
}

:root[data-theme="light"] .futuristic-tagline,
:root[data-theme="light"] .futuristic-tagline p {
  color: #475569 !important;
}


:root[data-theme="light"] .cta-button.secondary {
  background: rgba(15, 23, 42, 0.03);
  color: #0f172a !important;
  border-color: rgba(15, 23, 42, 0.1);
}
:root[data-theme="light"] .cta-button.secondary:hover {
  background: rgba(15, 23, 42, 0.07);
}

/* 3. Control Deck Section */
.control-deck-section {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  gap: 2.5rem;
  align-items: center;
  margin-bottom: 4.5rem;
}
.control-deck-intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.section-badge {
  font-family: monospace;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--cyber-primary);
  margin-bottom: 0.8rem;
}
.section-headline {
  margin: 0 0 1rem 0 !important;
  font-size: clamp(1.8rem, 3.2vw, 2.5rem) !important;
  font-weight: 800 !important;
  line-height: 1.15 !important;
  letter-spacing: -0.03em !important;
  color: #ffffff !important;
}
:root[data-theme="light"] .section-headline {
  color: #0f172a !important;
}
.section-description {
  font-size: 1.02rem;
  line-height: 1.65;
  color: #94a3b8;
  margin-bottom: 1.75rem;
}
:root[data-theme="light"] .section-description {
  color: #475569;
}
.cyber-inline-code {
  font-family: monospace;
  font-size: 0.85em;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 0.4rem;
  padding: 0.1rem 0.35rem;
  color: #14b8a6;
}
:root[data-theme="light"] .cyber-inline-code {
  background: rgba(15, 23, 42, 0.04);
  border-color: rgba(15, 23, 42, 0.08);
  color: #0d9488;
}

/* Specs & Metrics Grid */
.tech-specs-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  width: 100%;
}
.tech-spec-item {
  display: flex;
  flex-direction: column;
  padding: 0.75rem 1.25rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--cyber-border-glass);
  border-radius: 1rem;
}
:root[data-theme="light"] .tech-spec-item {
  background: rgba(15, 23, 42, 0.02);
}
.spec-label {
  font-size: 0.68rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  margin-bottom: 0.2rem;
}
.spec-value {
  font-size: 1.2rem;
  font-weight: 800;
  color: #f1f5f9;
}
:root[data-theme="light"] .spec-value {
  color: #0f172a;
}
.spec-value.neon-emerald {
  color: var(--neon-emerald);
}
.spec-platforms {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.35rem;
}
.spec-platforms span {
  display: inline-flex;
  align-items: center;
  font-size: 0.82rem;
  font-weight: 600;
  color: #94a3b8;
}
.spec-platforms span::before {
  content: "✦";
  margin-right: 0.45rem;
  color: var(--cyber-primary);
  font-size: 0.75rem;
}
:root[data-theme="light"] .spec-platforms span {
  color: #475569;
}

/* Control Deck Shell Wrapper */
.control-deck-wrapper {
  position: relative;
  width: 100%;
}
.cyber-control-deck {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 1.5rem;
  background: linear-gradient(135deg, rgba(8, 12, 22, 0.45) 0%, rgba(3, 7, 18, 0.45) 100%);
  border: 1px solid var(--cyber-border-glass);
  border-radius: 1.8rem;
  padding: 1.5rem;
  box-shadow: inset 0 0 25px rgba(255, 255, 255, 0.015);
}
:root[data-theme="light"] .cyber-control-deck {
  background: linear-gradient(135deg, rgba(241, 245, 249, 0.75) 0%, rgba(226, 232, 240, 0.75) 100%);
  border-color: rgba(15, 23, 42, 0.08);
}

/* 4. CSS Mobile Phone Simulator */
.cyber-phone-mock {
  position: relative;
  width: 200px;
  height: 380px;
  border: 8px solid #1e293b;
  border-radius: 1.8rem;
  background: #090d16;
  box-shadow: 
    0 15px 35px rgba(0, 0, 0, 0.5),
    0 0 0 1px rgba(255, 255, 255, 0.05);
  overflow: hidden;
  flex-shrink: 0;
  margin: 0 auto;
}
.phone-notch {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90px;
  height: 14px;
  background: #1e293b;
  border-bottom-left-radius: 0.6rem;
  border-bottom-right-radius: 0.6rem;
  z-index: 10;
}
.phone-home-pill {
  position: absolute;
  bottom: 5px;
  left: 50%;
  transform: translateX(-50%);
  width: 70px;
  height: 3px;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 2px;
  z-index: 10;
}
.phone-screen {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: #070a13;
  padding: 20px 10px 14px;
}
.phone-app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 6px;
  margin-bottom: 14px;
}
.app-logo {
  font-size: 0.65rem;
  font-weight: 800;
  color: var(--cyber-primary);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.app-status-dot {
  width: 5px;
  height: 5px;
  background: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 6px #10b981;
}
.phone-app-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.form-container {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.mock-label {
  font-size: 0.55rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.35);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.mock-input {
  position: relative;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 0.5rem;
  padding: 0.45rem 0.55rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.68rem;
  transition: all 0.3s ease;
}
.mock-input.active-highlight {
  border-color: var(--cyber-primary);
  background: rgba(20, 184, 166, 0.05);
}
@keyframes scan-line {
  0% { box-shadow: 0 0 0px var(--cyber-primary); opacity: 0.5; }
  50% { box-shadow: 0 0 8px var(--cyber-primary); opacity: 1; }
  100% { box-shadow: 0 0 0px var(--cyber-primary); opacity: 0.5; }
}
.scanning-crosshair {
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border: 1.5px solid var(--cyber-primary);
  border-radius: 0.5rem;
  pointer-events: none;
  animation: scan-line 2s infinite ease-in-out;
}
.mock-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 0.5rem;
  padding: 0.55rem;
  color: #ffffff;
  font-size: 0.7rem;
  font-weight: 700;
  text-align: center;
  position: relative;
}
.mock-btn.select-highlight {
  border-color: var(--cyber-secondary);
  background: rgba(99, 102, 241, 0.12);
  box-shadow: 0 0 8px rgba(99, 102, 241, 0.2);
}

/* 5. Cyber Terminal Mockup */
.cyber-terminal-mock {
  flex: 1;
  background: rgba(6, 9, 17, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 1.2rem;
  overflow: hidden;
  box-shadow: 
    0 15px 30px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.03);
  display: flex;
  flex-direction: column;
}
.terminal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.6rem 0.95rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(3, 5, 11, 0.85);
}
.terminal-controls {
  display: flex;
  gap: 0.35rem;
}
.terminal-controls .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}
.terminal-controls .dot.red { background: #ef4444; }
.terminal-controls .dot.yellow { background: #f59e0b; }
.terminal-controls .dot.green { background: #10b981; }

.terminal-tab {
  font-family: monospace;
  font-size: 0.68rem;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0.04em;
}
.terminal-status {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.status-pulse {
  width: 5px;
  height: 5px;
  background: var(--cyber-primary);
  border-radius: 50%;
  box-shadow: 0 0 6px var(--cyber-primary);
  animation: pulse 1.6s infinite ease-in-out;
}
.status-text {
  font-family: monospace;
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--cyber-primary);
  letter-spacing: 0.05em;
}
.terminal-body {
  padding: 0.95rem;
  margin: 0;
  overflow: auto;
  flex: 1;
}
.terminal-body pre {
  margin: 0;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
}
.terminal-body code {
  font-family: var(--__sl-font-mono) !important;
  font-size: 0.76rem !important;
  line-height: 1.6 !important;
  color: #cbd5e1;
}
.t-line {
  display: block;
}
.t-highlight {
  background: rgba(20, 184, 166, 0.07);
  border-left: 2px solid var(--cyber-primary);
  padding-left: 6px;
  margin-left: -8px;
}
.t-prompt { color: var(--cyber-primary); font-weight: 700; }
.t-command { color: #818cf8; }
.t-pkg { color: #cbd5e1; }
.t-method { color: #38bdf8; }
.t-flag { color: #c084fc; }
.t-val { color: #2dd4bf; }
.t-keyword { color: #f472b6; }
.t-obj { color: #e2e8f0; }
.t-str { color: #fbbf24; }
.t-prop { color: #34d399; }
.t-call { color: #f87171; }
.t-comment { color: rgba(255, 255, 255, 0.35); font-style: italic; }
.t-cursor {
  display: inline-block;
  width: 5px;
  height: 10px;
  background: var(--cyber-primary);
  margin-left: 2px;
  animation: blink 1.1s step-end infinite;
}

/* 6. Quantum Feature Cards */
.quantum-feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.25rem;
  align-items: stretch;
  margin: 4rem 0 3.5rem;
}
.quantum-feature-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--cyber-bg-glass);
  border: 1px solid var(--cyber-border-glass);
  height: 100%;
  border-radius: 1.5rem;
  padding: 1.5rem;
  backdrop-filter: blur(14px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}
.quantum-feature-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(20, 184, 166, 0.35), transparent);
}
.quantum-feature-card:hover {
  transform: translateY(-5px);
  border-color: rgba(20, 184, 166, 0.28);
  box-shadow: 
    0 15px 35px rgba(0, 0, 0, 0.25),
    0 0 20px rgba(20, 184, 166, 0.08);
}
.card-glow-bg {
  position: absolute;
  inset: auto 0 0 auto;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(20, 184, 166, 0.05) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}
.card-header {
  margin-bottom: 1.15rem;
  position: relative;
  z-index: 1;
}
.quantum-index-badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  background: rgba(20, 184, 166, 0.06);
  border: 1px solid rgba(20, 184, 166, 0.15);
}
.quantum-index-badge span {
  font-family: monospace;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--cyber-primary);
}
.badge-ring {
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(20, 184, 166, 0.08);
}
.quantum-feature-card h3 {
  margin: 0 0 0.6rem 0 !important;
  font-size: 1.18rem !important;
  font-weight: 700 !important;
  color: #ffffff !important;
  position: relative;
  z-index: 1;
}
.quantum-feature-card p {
  margin: 0;
  flex: 1;
  font-size: 0.92rem;
  line-height: 1.55;
  color: #94a3b8;
  position: relative;
  z-index: 1;
}

/* Light theme overrides for Quantum Cards */
:root[data-theme="light"] .quantum-feature-card {
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.03);
  border-color: rgba(15, 23, 42, 0.05);
}
:root[data-theme="light"] .quantum-feature-card h3 {
  color: #0f172a !important;
}
:root[data-theme="light"] .quantum-feature-card p {
  color: #475569;
}
:root[data-theme="light"] .quantum-feature-card:hover {
  border-color: rgba(20, 184, 166, 0.25);
  box-shadow: 
    0 15px 30px rgba(15, 23, 42, 0.05),
    0 0 15px rgba(20, 184, 166, 0.06);
}

/* 7. Quantum Extra Content & Why Sections */
.quantum-summary-paragraph {
  font-size: 1.15rem;
  line-height: 1.65;
  color: #94a3b8;
  text-align: center;
  max-width: 44rem;
  margin: 3.5rem auto 4rem;
  font-weight: 500;
}
:root[data-theme="light"] .quantum-summary-paragraph {
  color: #475569;
}

.quantum-why-section {
  display: flex;
  gap: 2rem;
  margin: 4rem 0 2rem;
  background: linear-gradient(135deg, rgba(20, 184, 166, 0.03) 0%, rgba(99, 102, 241, 0.02) 100%);
  border: 1px solid var(--cyber-border-glass);
  border-radius: 1.5rem;
  padding: 2rem;
  position: relative;
  overflow: hidden;
}
:root[data-theme="light"] .quantum-why-section {
  border-color: rgba(15, 23, 42, 0.05);
  background: linear-gradient(135deg, rgba(20, 184, 166, 0.02) 0%, rgba(99, 102, 241, 0.01) 100%);
}
.why-accent-line {
  position: absolute;
  left: 0;
  top: 1.8rem;
  bottom: 1.8rem;
  width: 4px;
  background: linear-gradient(180deg, var(--cyber-primary), var(--cyber-secondary));
  border-radius: 0 4px 4px 0;
}
.why-content {
  padding-left: 0.5rem;
}
.why-content h2 {
  margin: 0 0 1rem 0 !important;
  font-size: 1.75rem !important;
  font-weight: 800 !important;
}

.glass-code-wrapper {
  background: rgba(6, 10, 19, 0.45);
  border: 1px solid var(--cyber-border-glass);
  border-radius: 1.5rem;
  padding: 0.4rem;
  backdrop-filter: blur(10px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  margin: 2.5rem 0;
}
:root[data-theme="light"] .glass-code-wrapper {
  background: rgba(255, 255, 255, 0.4);
  border-color: rgba(15, 23, 42, 0.06);
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.03);
}
.glass-code-wrapper pre {
  margin: 0 !important;
}

.quantum-footer {
  margin-top: 4.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--cyber-border-glass);
  text-align: center;
  color: #64748b;
  font-size: 0.95rem;
}
:root[data-theme="light"] .quantum-footer {
  border-top-color: rgba(15, 23, 42, 0.06);
}
.text-glow-link {
  color: var(--cyber-primary) !important;
  font-weight: 700;
  text-decoration: none !important;
  transition: all 0.3s ease;
  border-bottom: 1px dashed rgba(20, 184, 166, 0.3);
}
.text-glow-link:hover {
  color: var(--cyber-primary) !important;
  text-shadow: 0 0 8px rgba(20, 184, 166, 0.45);
  border-bottom-style: solid;
  border-bottom-color: rgba(20, 184, 166, 0.8);
}

.sl-markdown-content :is(h2, h3) {
  letter-spacing: 0;
  line-height: 1.2;
  scroll-margin-top: 5rem;
}

.sl-markdown-content h2 {
  margin-top: 2.25rem;
  font-size: clamp(1.55rem, 2vw, 2rem);
}

.sl-markdown-content h3 {
  margin-top: 1.65rem;
  font-size: clamp(1.15rem, 1.5vw, 1.35rem);
}

.sl-markdown-content h4 {
  margin-top: 1.35rem;
  font-size: 1rem;
}

.sl-markdown-content > :is(p, ul, ol, table, pre) {
  margin-top: 0.85rem;
}

.sl-markdown-content > :is(h2, h3, h4) + :is(p, ul, ol, table, pre) {
  margin-top: 0.65rem;
}

.sl-markdown-content table {
  margin-block: 1rem 1.35rem;
}

.sl-markdown-content code:not(:where(.not-content *)) {
  border-radius: 0.4rem;
  padding: 0.12rem 0.3rem;
}

.card {
  border-radius: 1rem;
}

.astur-flow,
.astur-sequence,
.astur-split,
.astur-steps {
  margin: 1.5rem 0;
}

.astur-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.7rem;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 1rem;
  background: linear-gradient(135deg, rgba(36, 198, 183, 0.08), rgba(6, 47, 79, 0.04));
  padding: 1rem;
}

.astur-flow.compact {
  justify-content: center;
}

.flow-split {
  display: grid;
  gap: 0.7rem;
  width: 100%;
}

.flow-branch {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.7rem;
}

.flow-node,
.sequence-step,
.astur-split section {
  border: 1px solid var(--sl-color-hairline);
  border-radius: 0.8rem;
  background: var(--sl-color-bg);
  color: var(--sl-color-text);
  box-shadow: 0 10px 30px rgba(10, 23, 48, 0.06);
}

.flow-node {
  min-width: 9rem;
  padding: 0.8rem 0.95rem;
  font-weight: 720;
  line-height: 1.25;
}

.flow-node span {
  display: block;
  margin-top: 0.25rem;
  color: #62748e;
  font-size: 0.82rem;
  font-weight: 520;
}

.flow-node.primary {
  background: #0f8f86;
  border-color: #0f8f86;
  color: #fff;
}

.flow-node.primary span {
  color: rgba(255, 255, 255, 0.82);
}

.flow-node.accent {
  border-color: #24c6b7;
  background: #dff8f5;
  color: #063d48;
}

.flow-arrow {
  color: #0f8f86;
  font-weight: 800;
}

.astur-sequence {
  display: grid;
  gap: 0.8rem;
}

.sequence-step {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 0.9rem 1rem;
}

.sequence-step strong {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 1.8rem;
  height: 1.8rem;
  border-radius: 999px;
  background: #0f8f86;
  color: #fff;
}

.astur-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.astur-split section {
  padding: 1rem;
}

.astur-split h3 {
  margin-top: 0;
}

.astur-steps {
  list-style: none;
  counter-reset: astur-step;
  padding: 0;
}

.astur-steps li {
  position: relative;
  min-height: 2.35rem;
  margin: 0;
  padding: 0 0 1.35rem 3.35rem;
}

.astur-steps li:last-child {
  padding-bottom: 0;
}

.astur-steps li::before {
  counter-increment: astur-step;
  content: counter(astur-step);
  position: absolute;
  top: 0.05rem;
  left: 0;
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid rgba(163, 184, 204, 0.18);
  border-radius: 999px;
  background: linear-gradient(180deg, #1a2942, #10243f);
  color: #ffffff;
  font-size: 0.92rem;
  font-weight: 760;
  box-shadow: 0 12px 24px rgba(16, 36, 63, 0.16);
}

.astur-steps li::after {
  content: "";
  position: absolute;
  top: 2.28rem;
  bottom: 0.1rem;
  left: 0.98rem;
  width: 1px;
  background: linear-gradient(180deg, rgba(120, 144, 168, 0.56), rgba(120, 144, 168, 0.14));
}

.astur-steps li:last-child::after {
  display: none;
}

.astur-steps li > p,
.astur-steps li > :first-child {
  margin-top: 0;
}

.astur-steps li > :last-child {
  margin-bottom: 0;
}

:root[data-theme="dark"] .astur-steps li::before {
  border-color: rgba(163, 184, 204, 0.22);
  background: linear-gradient(180deg, rgba(19, 30, 49, 0.96), rgba(10, 19, 35, 0.98));
  box-shadow: 0 14px 28px rgba(3, 10, 22, 0.34);
}

:root[data-theme="dark"] .astur-steps li::after {
  background: linear-gradient(180deg, rgba(120, 144, 168, 0.5), rgba(120, 144, 168, 0.08));
}

@media (max-width: 50rem) {
  :root {
    --sl-text-5xl: 3rem;
  }

  .hero {
    min-height: auto;
    padding: 1.6rem;
  }

  .landing-shell,
  .landing-feature-grid,
  .astur-split {
    grid-template-columns: 1fr;
  }

  .landing-feature-card {
    min-height: auto;
  }

  .astur-steps li {
    padding-left: 3rem;
  }

  .astrolabe-orbits {
    transform: translate(-50%, -50%) scale(0.6);
  }

  .astur-split {
    grid-template-columns: 1fr;
  }
}
