# Xcode per-user state (not shared)
xcuserdata/
*.xcuserstate
packages/android-agent/.gradle/
packages/android-agent/build/

# Local Claude Code state
.claude/

# Local-only agent context map (not tracked)
AGENTS.md

# Org profile staging file (the real copy lives in the Astur-mobile/.github repo)
/ORG-PROFILE-README.md

# Large demo-app binaries. The iOS simulator apps ship zipped; examples/scripts/
# ensure-ios-app.mjs extracts them to assets/Astur.app and assets/Runner.app on
# demand (see examples/package.json test:ios:simulator / test:ios:flutter /
# codegen:ios:*). The unpacked .app bundles, their extraction sentinels, and the
# real-device .ipa are kept out of the repo.
assets/Astur.app/
assets/Runner.app/
assets/*.source-zip.json
assets/*.ipa

# Internal/local architecture drafts. Keep docs/architecture.md public and user-facing.
*.local.md
ARCHITECTURE.*.md
architecture*.local.md
*.architecture.local.md
docs/**/ARCHITECTURE.*.md
!docs/architecture.md

# npm pack / publish outputs and package-manager logs
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local review notes and scratch scripts kept beside the repo, not in it
/*REVIEW*.md
/test.js
/scratch/

# Local brainstorming mockups
.superpowers/
